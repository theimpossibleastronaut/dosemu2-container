# Copy this file to .env and edit. docker compose reads .env
# automatically. All values below are optional — the defaults work
# out of the box.

# Which image tag the `dosemu2` service runs:
#   release         = latest released dosemu2 (default)
#   latest          = latest dev build from dosemu2 git, with GUI support
#   latest-headless = same dev build, no GUI support, smallest image
TAG=release

# Tag for the `gui` service. Kept separate from TAG because
# :latest-headless has no SDL3/X11 and cannot open a window.
#GUI_TAG=release

# Image repository. Defaults to the published Docker Hub image.
# If you built locally with `make all`, set this to your local
# runtime image name (e.g. dosemu2).
IMAGE=andy5995/dosemu2

# Named volume (or a host path) for DOS file / config persistence.
#DOSEMU_HOME=dosemu-home

# Only used by the `build-env` service: host path to your dosemu2
# source tree, mounted at /workspace inside the container.
#DOSEMU2_SRC=./dosemu2-src

# Only used by the `build-env` service. The container remaps its build
# user to the owner of /workspace automatically, so files you build
# stay owned by you. Set these only to override the auto-detection
# (e.g. a root-owned source dir, or a CI matrix). Your IDs: run `id -u`
# and `id -g`.
#HOSTUID=
#HOSTGID=
