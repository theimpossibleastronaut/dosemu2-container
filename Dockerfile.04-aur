# syntax=docker/dockerfile:1.6
#
# Phase 04 — install AUR-built deps from the host-side binary repo.
#
# Input:  dosemu2-builder:01-pacman   (no intermediate bootstrap
#         phases — the prebuilt packages here include the real
#         djgpp-djcrx and paru itself)
# Output: dosemu2-builder:04-aur (also tagged :build-env)
#
# Previously this phase ran paru -S on the AUR leaves, which compiled
# djgpp-gcc, djgpp-djcrx, fdpp, dj64, comcom*, munt etc. from source —
# ~30 min on the runner with djgpp-gcc as the long pole. The
# aur-pkgs/ directory in this repo now holds those packages prebuilt
# (via Git LFS), so this phase reduces to "COPY + pacman -U" and
# completes in seconds.
#
# When a new AUR package is needed: build it inside :build-env
# (paru is installed, so paru -S <pkg> works), pull the resulting
# .pkg.tar.zst out of /var/cache/paru or /tmp, drop it into
# aur-pkgs/, rerun `repo-add`, and commit. CI's separate
# build-aur-pkg.yml workflow does the same and uploads the .zst as
# an artifact. See aur-pkgs/README.md.

ARG BASE=ghcr.io/theimpossibleastronaut/dosemu2-container:01-pacman

FROM ${BASE}

# Bind-mount aur-pkgs/ from the build context for the duration of
# the install. Using --mount=type=bind instead of COPY keeps the
# .pkg.tar.zst files out of the image — they're 371 MB of already-
# installed-system-wide bytes that would otherwise sit at
# /opt/aur-pkgs/ as dead weight in :build-env. The PostTransaction
# hook installed in Phase 01 auto-clears /var/cache/pacman/pkg.
RUN --mount=type=bind,source=aur-pkgs,target=/tmp/aur-pkgs \
    sudo pacman -U --noconfirm /tmp/aur-pkgs/*.pkg.tar.zst

# Runtime entrypoint: remap builder's UID/GID to match the
# bind-mounted workspace owner so files written from inside the
# container land on the host with correct ownership. See
# entrypoint.sh for details. USER root so the entrypoint can
# usermod/groupmod; entrypoint drops to builder before exec'ing.
# Phase 05 overrides both USER and ENTRYPOINT, so this only
# affects the :build-env / :04-aur tag.
USER root
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
