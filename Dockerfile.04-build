# syntax=docker/dockerfile:1.6
#
# Phase 04 — build dosemu2 from a bind-mounted local source tree, with
# a slim Alpine runtime as the final stage.
#
# Input:   dosemu2-builder:03-toolchain (Alpine + dj64dev/comcom64/
#          fdpp/libsearpc toolchain, adapted from dosemu2 upstream's
#          Dockerfile.alpine by Stas Sergeev / stsp)
# Outputs: dosemu2-builder:04-build, dosemu2:latest, dosemu2:latest-headless
#
# Three stages:
#   builder            — full :03-toolchain env, which has the GUI
#                         (SDL3/X11) build deps too. Untars host source
#                         (passed via additional_contexts=dosemu2),
#                         autogen + configure + make + make install
#                         DESTDIR=/install. dosemu2's configure
#                         autodetects SDL3/X11 and builds GUI support
#                         in — one build serves both runtime targets.
#   runtime            — fresh alpine:3.21 base + SDL3/X11/audio runtime
#                         libs. Tagged :latest — the default, GUI-capable
#                         image.
#   runtime-headless   — same base, WITHOUT SDL3/X11 — dosemu2's video
#                         backends are dlopen'd plugins, so the binary
#                         still runs text-mode-only without them. Tagged
#                         :latest-headless. Pick --target at build time.
#
# The published images drop binutils, meson, git, and every other
# build-only tool that only :build-env needs.

# Default BASE points at the published GHCR image; Makefile overrides
# with dosemu2-builder:03-toolchain for local-only chained builds.
ARG BASE=ghcr.io/theimpossibleastronaut/dosemu2-container:03-toolchain

# ---------------------------------------------------------------------------
# Stage 1: builder
# ---------------------------------------------------------------------------
FROM ${BASE} AS builder

# Bind-mount host source RO, untar into a writable scratch dir so the
# build doesn't pollute the host with .o files / autogen output.
# git clean -dfx (after untar, before configure) builds from pristine
# tracked source — strips any in-tree artifacts the host tree carries,
# e.g. config.status with /workspace paths left by an in-tree configure
# in the build-env container.
RUN --mount=type=bind,from=dosemu2,target=/src,readonly \
    rm -rf /root/dosemu2 \
 && mkdir -p /root/dosemu2 \
 && (cd /src && tar -cf - .) | tar -xf - -C /root/dosemu2 \
 && cd /root/dosemu2 \
 && git clean -dfx \
 && ./autogen.sh \
 && ./configure \
 && make -j"$(nproc)" \
 && make install DESTDIR=/install

# The runtime stages COPY this /usr/local wholesale (dosemu2's own
# runtime libs live alongside the toolchain's), but most of what's
# under it is build-only: the i686-unknown-linux-gnu binutils
# cross-tools, dj64dev/smallerc headers and static archives, and the
# locale/info/man/doc data binutils' own `make install` pulls in.
# None of that dosemu2 loads at runtime — pruning it here (not in
# Phase 03) keeps :build-env / :03-toolchain itself untouched for
# anyone building their own dosemu2 from it.
RUN rm -rf \
        /usr/local/bin/i686-unknown-linux-gnu-* \
        /usr/local/i686-unknown-linux-gnu \
        /usr/local/smlrc \
        /usr/local/libexec/thunk_gen \
        /usr/local/libexec/djstub2 \
        /usr/local/include \
        /usr/local/i386-pc-dj64/include \
        /usr/local/i386-pc-dj64/lib \
        /usr/local/i386-pc-dj64/lib64/libdj64_s.a \
        /usr/local/i386-pc-dj64/share \
        /usr/local/lib/bfd-plugins \
        /usr/local/share/locale \
        /usr/local/share/info \
        /usr/local/share/man \
        /usr/local/share/doc

# ---------------------------------------------------------------------------
# Stage 2: runtime — full, GUI-capable. Tagged :latest.
# ---------------------------------------------------------------------------
FROM alpine:3.21 AS runtime

RUN apk add --no-cache \
        elfutils \
        jansson \
        glib \
        slang \
        bash \
        json-c \
        libslirp \
        gawk \
        libseccomp \
        alsa-lib \
        fluidsynth \
        ladspa \
        gpm \
        libsamplerate \
        vde2 \
        libx11 \
        libxext
RUN apk add --no-cache libb64 \
        --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing
RUN apk add --no-cache sdl3 \
        --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community

# The toolchain's own runtime libs (libsearpc, libfdpp, libdj64,
# comcom64) live under /usr/local in :03-toolchain, same as upstream's
# single-stage COPY --from=builder /usr/local /usr/local.
COPY --from=builder /usr/local /usr/local
COPY --from=builder /install /

RUN addgroup -S dosuser \
 && adduser -S -G dosuser -h /home/dosuser dosuser \
 && install -d -m 0755 -o dosuser -g dosuser /home/dosuser/.dosemu

USER dosuser
WORKDIR /home/dosuser
ENTRYPOINT ["dosemu"]

# ---------------------------------------------------------------------------
# Stage 3: runtime-headless — no SDL3/X11. Tagged :latest-headless.
# ---------------------------------------------------------------------------
FROM alpine:3.21 AS runtime-headless

RUN apk add --no-cache \
        elfutils \
        jansson \
        glib \
        slang \
        bash \
        json-c \
        libslirp \
        gawk \
        libseccomp
RUN apk add --no-cache libb64 \
        --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing

COPY --from=builder /usr/local /usr/local
COPY --from=builder /install /

RUN addgroup -S dosuser \
 && adduser -S -G dosuser -h /home/dosuser dosuser \
 && install -d -m 0755 -o dosuser -g dosuser /home/dosuser/.dosemu

USER dosuser
WORKDIR /home/dosuser
ENTRYPOINT ["dosemu"]
